# Email sending (any SMTP provider: Gmail app password, Outlook, Resend SMTP, SendGrid...)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
# Optional: shown as the sender (defaults to SMTP_USER)
MAIL_FROM="Daily Checklists <you@example.com>"
# Optional: always CC these addresses on every send (comma separated)
MAIL_TO=manager@example.com
# Optional: only allow sending to these domains (comma separated)
MAIL_ALLOWED_DOMAINS=
